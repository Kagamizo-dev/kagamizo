+/// The secret in an `item view --output json` answer: the note body when no
+/// `field` is named, else that field. A custom item (an "API credential",
+/// say) keeps its fields as `item.content.extra_fields[]`, each a `name` and
+/// a typed value (`Hidden`, `Text`, `Totp`, `Timestamp`); a login item also
+/// has its own `username`, `password`, `email` and `totp_uri`.
+fn item_value(view: &str, field: Option<&str>) -> Option<String> {
+    let json: serde_json::Value = serde_json::from_str(view).ok()?;
+    let content = json.get("item")?.get("content")?;
+    let text = |v: &serde_json::Value| match v {
+        serde_json::Value::String(s) => Some(s.clone()),
+        serde_json::Value::Number(n) => Some(n.to_string()),
+        _ => None,
+    };
+    let found = match field {
+        None => content.get("note").and_then(text),
+        Some(name) => content
+            .get("extra_fields")
+            .and_then(|f| f.as_array())
+            .and_then(|fields| {
+                fields.iter().find_map(|f| {
+                    if f.get("name")?.as_str()? != name {
+                        return None;
+                    }
+                    f.get("content")?.as_object()?.values().next().and_then(text)
+                })
+            })
+            // A custom item made by pass-cli keeps its fields in sections
+            // (content.Custom.sections[].section_fields), where the app's
+            // templates use extra_fields: the same names and kinds.
+            .or_else(|| {
+                content
+                    .get("content")?
+                    .get("Custom")?
+                    .get("sections")?
+                    .as_array()?
+                    .iter()
+                    .filter_map(|s| s.get("section_fields")?.as_array())
+                    .flatten()
+                    .find_map(|f| {
+                        if f.get("name")?.as_str()? != name {
+                            return None;
+                        }
+                        f.get("content")?.as_object()?.values().next().and_then(text)
+                    })
+            })
+            .or_else(|| {
+                content
+                    .get("content")?
+                    .get("Login")?
+                    .get(name)
+                    .and_then(text)
+            }),
+    };
+    found.filter(|v| !v.is_empty())
+}
