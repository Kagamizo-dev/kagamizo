+    /// The note body without a field; a custom item's field or a login's own
+    /// field with one; nothing for a field the item does not have.
+    #[test]
+    fn item_value_reads_notes_and_fields() {
+        let note = r#"{"item":{"content":{"title":"t","note":"n0te"}}}"#;
+        assert_eq!(item_value(note, None).as_deref(), Some("n0te"));
+        let custom = r#"{"item":{"content":{"title":"Public","note":"","extra_fields":[
+            {"name":"API key","content":{"Hidden":"label"}},
+            {"name":"Secret","content":{"Hidden":"s3cret"}},
+            {"name":"Expiry date","content":{"Timestamp":1792000000}},
+            {"name":"Permissions","content":{"Text":""}}]}}}"#;
+        assert_eq!(item_value(custom, Some("Secret")).as_deref(), Some("s3cret"));
+        assert_eq!(item_value(custom, Some("Expiry date")).as_deref(), Some("1792000000"));
+        assert_eq!(item_value(custom, Some("Permissions")), None);
+        assert_eq!(item_value(custom, Some("Missing")), None);
+        assert_eq!(item_value(custom, None), None);
+        let sectioned = r#"{"item":{"content":{"title":"k","note":"","content":{"Custom":{"sections":[
+            {"section_name":"API credential","section_fields":[
+            {"name":"API key","content":{"Hidden":"k3y"}},
+            {"name":"Expiry date","content":{"Timestamp":0}}]}]}}}}}"#;
+        assert_eq!(item_value(sectioned, Some("API key")).as_deref(), Some("k3y"));
+        assert_eq!(item_value(sectioned, Some("Missing")), None);
+        let login = r#"{"item":{"content":{"title":"L","note":"","content":{"Login":{"username":"u","password":"p"}}}}}"#;
+        assert_eq!(item_value(login, Some("password")).as_deref(), Some("p"));
