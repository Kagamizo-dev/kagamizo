# The host's cloud resources, as OpenTofu (the pinned hcloud provider,
# ../catalog/_json/hetzner-provider.json): a fixed IPv4, a firewall that
# admits nothing, and the server, whose first boot installs NixOS
# (./host.nix) from this repository at the commit applied.
#
#   nix run .#hetzner-infra -- plan     read Hetzner's prices, refuse a total
#                                       over hetzner.monthlyBudgetUsd, plan
#   nix run .#hetzner-infra -- apply    the same, then apply
#   nix run .#hetzner-infra -- init-state
#                                       a state passphrase, generated by
#                                       pass-cli straight into Proton Pass
#
# Hetzner has no spending limit of its own: the budget is enforced here,
# from Hetzner's live prices (GET /pricing) for the declared server type and
# address in the declared location. The state is kept in Proton Pass by
# statestore (../statestore, hetzner@<generation> in the owner's sessions
# vault), encrypted with TOFU_STATE_PASSPHRASE.
#
# Installing it: the server boots Hetzner's image with the install key's
# public half; the host-install workflow (./install.nix) runs nixos-anywhere
# against it over SSH, inside a dated install window, which partitions the
# disk as declared (disko) and installs jingzo-host from this repository.
# The installed host runs no SSH server, and the window then closes.
{
  lib,
  config,
  self,
  ...
}:
let
  inherit (lib) mkOption types;
  top = config;
  cfg = config.hetzner;
  provider = lib.importJSON ../catalog/_json/hetzner-provider.json;
  api = lib.importJSON ../catalog/_json/hetzner-api.json;

  rev = self.rev or null;

  tofu = {
    terraform.required_providers.hcloud.source = "hetznercloud/hcloud";
    # Served by statestore-run (../statestore) from Proton Pass.
    terraform.backend.http = { };
    resource = {
      hcloud_primary_ip.host = {
        name = "${cfg.host.name}-ipv4";
        type = "ipv4";
        location = cfg.host.location;
        auto_delete = false;
        delete_protection = true;
        labels.owner = top.accounts.held.hetzner.owner;
      };
      # Admits nothing: the host has no service to reach, and is changed
      # through the repository, not over the network. The one exception is
      # SSH to the installer during a declared, dated install window
      # (./install.nix): nixos-anywhere's only way in, closed again after.
      hcloud_firewall.host = {
        name = "${cfg.host.name}-closed";
        labels.owner = top.accounts.held.hetzner.owner;
        # The pinned hcloud provider never clears a firewall's last rule
        # (it plans the removal, reports it applied, and Hetzner keeps the
        # rule: 2026-11-03). So a closed firewall holds one rule that
        # admits nothing usable: ICMP from TEST-NET-1 (192.0.2.0/24, RFC
        # 5737), never routed on the internet.
        rule = [
          (
            if cfg.host.install.window == null then
              {
                direction = "in";
                protocol = "icmp";
                source_ips = [ "192.0.2.0/24" ];
                description = "closed (admits nothing: TEST-NET-1, RFC 5737)";
              }
            else
              {
                direction = "in";
                protocol = "tcp";
                port = "22";
                source_ips = [
                  "0.0.0.0/0"
                  "::/0"
                ];
                description = "install window until ${cfg.host.install.window.until}";
              }
          )
        ];
      };
      # The install key's public half; its private half stays in Proton Pass.
      hcloud_ssh_key.install = {
        name = "${cfg.host.name}-install";
        public_key = cfg.host.install.publicKey;
        labels.owner = top.accounts.held.hetzner.owner;
      };
      hcloud_server.host = {
        name = cfg.host.name;
        server_type = cfg.host.serverType;
        location = cfg.host.location;
        image = cfg.host.bootstrapImage;
        # nixos-anywhere installs over SSH (./install.nix); no first-boot
        # script races it.
        ssh_keys = [ "\${hcloud_ssh_key.install.id}" ];
        firewall_ids = [ "\${hcloud_firewall.host.id}" ];
        public_net = {
          ipv4_enabled = true;
          ipv4 = "\${hcloud_primary_ip.host.id}";
          ipv6_enabled = false;
        };
        labels.owner = top.accounts.held.hetzner.owner;
      };
    }
    // lib.optionalAttrs (cfg.volumes != { }) {
      # Raw block devices; the host encrypts them (LUKS, key in Proton Pass).
      hcloud_volume = lib.mapAttrs (n: v: {
        name = "${cfg.host.name}-${n}";
        size = v.sizeGb;
        server_id = "\${hcloud_server.host.id}";
        automount = false;
        delete_protection = false;
        labels = {
          owner = top.accounts.held.hetzner.owner;
          inherit (v) until;
        };
      }) cfg.volumes;
    };
    output.ipv4.value = "\${hcloud_primary_ip.host.ip_address}";
  };

  # Every attribute set above exists on its resource in the pinned provider.
  tofuProblems = lib.concatLists (
    lib.mapAttrsToList (
      type: rs:
      lib.concatLists (
        lib.mapAttrsToList (
          _: r:
          map (a: "${type}.${a}: not an attribute of the pinned provider") (
            lib.filter (a: a != "lifecycle" && !(provider.resources.${type} ? ${a})) (lib.attrNames r)
          )
        ) rs
      )
    ) tofu.resource
  );
  pricingOk = api.operations ? get_pricing && api.operations.get_pricing.path == "/pricing";
in
{
  options.hetzner.volumes = mkOption {
    type = types.attrsOf (
      types.submodule {
        options = {
          sizeGb = mkOption { type = types.ints.between 10 10240; };
          why = mkOption { type = types.str; };
          until = mkOption {
            type = types.strMatching "[0-9]{4}-[0-9]{2}-[0-9]{2}";
            description = "When it is removed; the plan refuses it after this date.";
          };
        };
      }
    );
    default = { };
    description = "Block volumes on the host, each priced against the budget and dated.";
  };

  options.hetzner.host = {
    serverType = mkOption {
      type = types.strMatching "[a-z]+[0-9]+";
      default = "cpx11";
      description = "Hetzner's server type; its price is checked against the budget.";
    };
    location = mkOption {
      type = types.enum [
        "ash"
        "hil"
        "fsn1"
        "nbg1"
        "hel1"
        "sin"
      ];
      # On Hetzner's prices of 2026-10-24, cpx11 is $5.99 a month in fsn1,
      # nbg1 and hel1 and $20.49 in ash; only the EU fits the $7 budget, and
      # the plan checks the live price either way.
      default = "fsn1";
      description = "Where the server and its address live; prices differ by location.";
    };
    bootstrapImage = mkOption {
      type = types.str;
      default = "ubuntu-24.04";
      description = "The image Hetzner boots first; its only job is to run the first-boot script.";
    };
  };

  config = {
    # The host's state, beside its token in the owner's sessions vault.
    statestore.backends.hetzner.vault = config.proton.sessionVaults.${top.accounts.held.hetzner.owner};

    secrets.profiles.hetzner = {
      TOFU_STATE_PASSPHRASE =
        (import ../_lib/secret.nix) {
          kind = "encryption-key";
          issuer = "automation:hetzner-infra";
          description = "Passphrase of the Hetzner host's OpenTofu state";
          item = "hetzner-tofu-passphrase";
        }
        // {
          required = false;
        };
    };

    governance.actions.hetzner = {
      infra-plan = {
        effect = "read";
        description = "Hetzner's prices against the budget, and the host's OpenTofu plan";
        command = "hetzner-infra plan";
      };
      infra-apply = {
        effect = "spend";
        description = "Create or change the host's server, address and firewall";
        command = "hetzner-infra apply";
      };
      prices = {
        effect = "read";
        description = "Record Hetzner's prices and which types each location still sells (./_json/prices.json)";
        command = "hetzner-prices";
      };
    };

    perSystem =
      { pkgs, config, ... }:
      let
        main = pkgs.writeText "main.tf.json" (
          assert lib.assertMsg (tofuProblems == [ ]) (
            "modules/hetzner/infra.nix:\n" + lib.concatStringsSep "\n" tofuProblems
          );
          assert lib.assertMsg pricingOk "modules/hetzner/infra.nix: GET /pricing is not in the pinned API";
          builtins.toJSON tofu
        );
        spec = config.packages.secretspec-toml;
        run = pkgs.writeShellApplication {
          name = "hetzner-infra-run";
          runtimeInputs = [
            config.packages.tofu-hetzner
            config.packages.statestore-run
            pkgs.bash
            pkgs.curl
            pkgs.jq
            pkgs.coreutils
            pkgs.diffutils
          ];
          text = ''
            : "''${HCLOUD_TOKEN:?no Hetzner token in Proton Pass}" "''${TOFU_STATE_PASSPHRASE:?run hetzner-infra init-state first}"
            # Hetzner's own prices for what is declared, against the budget.
            prices=$(curl -fsS -H "Authorization: Bearer $HCLOUD_TOKEN" https://api.hetzner.cloud/v1/pricing)
            currency=$(jq -r .pricing.currency <<<"$prices")
            [ "$currency" = USD ] || { echo "hetzner-infra: prices are in $currency, the budget in USD" >&2; exit 1; }
            server=$(jq -r --arg t ${cfg.host.serverType} --arg l ${cfg.host.location} \
              '.pricing.server_types[] | select(.name == $t) | .prices[] | select(.location == $l) | .price_monthly.gross' <<<"$prices")
            ip=$(jq -r --arg l ${cfg.host.location} \
              '.pricing.primary_ips[] | select(.type == "ipv4") | .prices[] | select(.location == $l) | .price_monthly.gross' <<<"$prices")
            [ -n "$server" ] && [ -n "$ip" ] || { echo "hetzner-infra: no price for ${cfg.host.serverType} or IPv4 in ${cfg.host.location}" >&2; exit 1; }
            # Hetzner withdraws types per location (cpx11 in the EU after
            # 2025-12-31, found on the first apply): refused here, not by the
            # provider halfway through an apply.
            types=$(curl -fsS -H "Authorization: Bearer $HCLOUD_TOKEN" "https://api.hetzner.cloud/v1/server_types?per_page=50")
            gone=$(jq -r --arg t ${cfg.host.serverType} --arg l ${cfg.host.location} '.server_types[] | select(.name == $t)
              | (.deprecation.unavailable_after // empty), ((.locations // [])[] | select(.name == $l) | .deprecation.unavailable_after // empty)' <<<"$types" | head -1)
            [ -z "$gone" ] || { echo "hetzner-infra: ${cfg.host.serverType} is withdrawn in ${cfg.host.location} after $gone; pick another type (hetzner.host.serverType)" >&2; exit 1; }
            ${lib.optionalString (cfg.host.install.window != null) ''
              # SSH is open only until its declared date.
              [[ "$(date -u +%F)" < "${cfg.host.install.window.until}" || "$(date -u +%F)" == "${cfg.host.install.window.until}" ]] ||
                { echo "hetzner-infra: the install window closed on ${cfg.host.install.window.until}; set hetzner.host.install.window = null" >&2; exit 1; }
            ''}
            pergb=$(jq -r '.pricing.volume.price_per_gb_month.gross' <<<"$prices")
            gb=${toString (lib.foldl' (n: v: n + v.sizeGb) 0 (lib.attrValues cfg.volumes))}
            today=$(date -u +%F)
            untils=(${lib.concatStringsSep " " (lib.mapAttrsToList (_: v: v.until) cfg.volumes)})
            for until in "''${untils[@]}"; do
              [[ "$today" < "$until" || "$today" == "$until" ]] ||
                { echo "hetzner-infra: a volume was to be removed by $until; remove it from hetzner.volumes" >&2; exit 1; }
            done
            total=$(jq -n --arg s "$server" --arg i "$ip" --arg p "$pergb" --arg g "$gb" \
              '($s|tonumber) + ($i|tonumber) + ($p|tonumber) * ($g|tonumber)')
            budget=${toString cfg.monthlyBudgetUsd}
            echo "hetzner-infra: ${cfg.host.serverType} \$$server + IPv4 \$$ip + $gb GB of volumes = \$$total a month, budget \$$budget" >&2
            jq -en --arg t "$total" --arg b "$budget" '($t|tonumber) <= ($b|tonumber)' >/dev/null ||
              { echo "hetzner-infra: over budget; refused" >&2; exit 1; }

            passphrase=$(jq -rn --arg p "$TOFU_STATE_PASSPHRASE" '$p | tojson | gsub("\\$\\{"; "$${") | gsub("%\\{"; "%%{")')
            TF_ENCRYPTION=$(printf 'key_provider "pbkdf2" "state" {\n  passphrase = %s\n}\nmethod "aes_gcm" "state" {\n  keys = key_provider.pbkdf2.state\n}\nstate {\n  method = method.aes_gcm.state\n  enforced = true\n}\nplan {\n  method = method.aes_gcm.state\n  enforced = true\n}\n' "$passphrase")
            export TF_ENCRYPTION
            work=$(mktemp -d)
            trap 'rm -rf "$work"' EXIT
            cp ${main} "$work/main.tf.json"
            # The state lives in Proton Pass (statestore.backends.hetzner),
            # served and locked for this run.
            mode=-input=false
            [ "$1" = apply ] && mode=-auto-approve
            status=0
            # The script's $0, $1 and $2 are its own arguments.
            # shellcheck disable=SC2016
            statestore-run hetzner -- bash -c '
              tofu -chdir="$0" init -input=false >&2 && tofu -chdir="$0" "$1" -input=false "$2"
            ' "$work" "$1" "$mode" || status=$?
            exit "$status"
          '';
        };
        inner = pkgs.writeShellApplication {
          name = "hetzner-infra";
          runtimeInputs = [
            config.packages.secretspec
            config.packages.pass-cli
            config.packages.governance-authorize
            pkgs.coreutils
          ];
          text = builtins.seq top.accounts.checked ''
            usage="usage: hetzner-infra <plan|apply|init-state>"
            case "''${1:-}" in
              plan) governance-authorize hetzner:infra-plan hetzner ;;
              apply)
                ${
                  if rev == null then
                    ''echo "hetzner-infra: apply only from a clean, committed tree (the first boot installs that commit)" >&2; exit 2''
                  else
                    "governance-authorize hetzner:infra-apply hetzner"
                }
                ;;
              init-state)
                governance-authorize hetzner:infra-apply hetzner
                # Generated by pass-cli and piped into Proton Pass: never printed.
                pass-cli password generate random --length 48 |
                  secretspec set TOFU_STATE_PASSPHRASE --file ${spec} --profile hetzner \
                    --reason "hetzner-infra: the state passphrase" --from-file /dev/stdin >/dev/null
                echo "hetzner-infra: state passphrase stored in Proton Pass" >&2
                exit 0
                ;;
              *) echo "$usage" >&2; exit 2 ;;
            esac
            exec secretspec run --file ${spec} --profile hetzner --reason "hetzner-infra $1" -- ${lib.getExe run} "$1"
          '';
        };
        frozen = import ../_lib/frozen.nix {
          inherit lib pkgs;
          inherit (top) runtime;
        };
      in
      {
        packages = {
          # The price ledger: every observation of Hetzner's prices and
          # availability, appended and committed, so price movements are
          # on record (the owner's ask, 2026-11-01). One line per run.
          hetzner-prices = pkgs.writeShellApplication {
            name = "hetzner-prices";
            runtimeInputs = [
              config.packages.secretspec
              config.packages.pass-cli
              config.packages.governance-authorize
              pkgs.curl
              pkgs.jq
              pkgs.git
              pkgs.coreutils
            ];
            text = builtins.seq top.accounts.checked ''
              export PROTON_PASS_KEY_PROVIDER=''${PROTON_PASS_KEY_PROVIDER:-fs}
              governance-authorize hetzner:prices hetzner
              cd "$(git rev-parse --show-toplevel)"
              f=modules/hetzner/_json/prices.json
              dir=$(mktemp -d)
              # The token expands inside secretspec's environment, not here.
              # shellcheck disable=SC2016
              secretspec run --file ${spec} --profile hetzner --reason "hetzner-prices" -- sh -c '
                curl -fsS -H "Authorization: Bearer $HCLOUD_TOKEN" https://api.hetzner.cloud/v1/pricing > "$1/pricing.json"
                curl -fsS -H "Authorization: Bearer $HCLOUD_TOKEN" "https://api.hetzner.cloud/v1/server_types?per_page=50" > "$1/types.json"
              ' _ "$dir"
              obs=$(jq -n --arg at "$(date -u +%FT%TZ)" --slurpfile p "$dir/pricing.json" --slurpfile t "$dir/types.json" '{
                at: $at,
                currency: $p[0].pricing.currency,
                ipv4Monthly: ($p[0].pricing.primary_ips[] | select(.type == "ipv4") | .prices | map({(.location): .price_monthly.gross}) | add),
                volumePerGbMonth: $p[0].pricing.volume.price_per_gb_month.gross,
                serverTypes: ($t[0].server_types | map({(.name): {
                  cores, memory, disk, architecture,
                  monthly: (.prices | map({(.location): .price_monthly.gross}) | add),
                  withdrawn: ((.locations // []) | map(select(.deprecation != null) | {(.name): .deprecation.unavailable_after}) | add)
                }}) | add)
              }')
              jq --argjson o "$obs" '.observations += [$o]' "$f" > "$f.new" && mv "$f.new" "$f"
              rm -rf "$dir"
              jq -r '.observations[-1] | "hetzner-prices: recorded \(.at): \(.serverTypes | length) types, IPv4 \(.ipv4Monthly.fsn1), volume \(.volumePerGbMonth)/GB"' "$f"
              git status --short "$f"
            '';
          };
          hetzner-infra-config = main;
          hetzner-infra-inner = inner;
          hetzner-infra = frozen {
            name = "hetzner-infra";
            program = lib.getExe inner;
            packages = [ ];
          };
        };
        checks.hetzner-infra =
          pkgs.runCommand "hetzner-infra-validate"
            {
              nativeBuildInputs = [ config.packages.tofu-hetzner ];
            }
            ''
              export HOME=$TMPDIR
              cp ${main} main.tf.json
              tofu init -backend=false -input=false >/dev/null
              tofu validate
              touch $out
            '';
      };
  };
}
