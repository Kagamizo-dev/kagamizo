      "effect": "read"
    },
    "get_instrument": {
      "group": "instrument_details",
      "method": "GET",
      "path": "/userapigateway/trading/instruments/{symbol}/{type_}",
      "command": "instruments get",
      "effect": "read"
    },
    "get_option_chain": {
      "group": "market_data",
      "method": "POST",
      "path": "/userapigateway/marketdata/{account_id}/option-chain",
      "command": "market option-chain",
      "effect": "read"
    },
    "get_option_expirations": {
      "group": "market_data",
      "method": "POST",
      "path": "/userapigateway/marketdata/{account_id}/option-expirations",
