      "method": "GET",
      "path": "/userapigateway/trading/{account_id}/taxlots/csv/unrealized",
      "command": "taxlots csv",
      "effect": "read"
    },
    "get_unrealized_tax_lots_for_symbol": {
      "group": "tax_lot_selling",
      "method": "GET",
      "path": "/userapigateway/trading/{account_id}/taxlots/unrealized/{symbol}",
      "command": "taxlots symbol",
      "effect": "read"
    },
    "place_multileg_order": {
      "group": "order_placement",
      "method": "POST",
      "path": "/userapigateway/trading/{account_id}/order/multileg",
      "command": "order place-multileg",
      "effect": "spend"
    },
    "place_order": {
      "group": "order_placement",
      "method": "POST",
      "path": "/userapigateway/trading/{account_id}/order",
      "command": "order place",
      "effect": "spend"
    },
    "preflight_multi_leg": {
      "group": "order_placement",
      "method": "POST",
      "path": "/userapigateway/trading/{account_id}/preflight/multi-leg",
      "command": "order preflight-multi",
      "effect": "read"
    },
    "preflight_single_leg": {
      "group": "order_placement",
      "method": "POST",
      "path": "/userapigateway/trading/{account_id}/preflight/single-leg",
      "command": "order preflight-single",
      "effect": "read"
    },
    "replace_order": {
      "group": "order_placement",
      "method": "PUT",
      "path": "/userapigateway/trading/{account_id}/order",
      "command": "order replace",
      "effect": "spend"
    },
