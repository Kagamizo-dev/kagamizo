  "clients": {
    "reader": {
      "why": "every trade-run command but place: reads, quotes and preflights, which place nothing",
      "endpoints": [
        "create_personal_access_token",
        "get_accounts",
        "get_instrument",
        "get_bars_v2_with_aggregation",
        "preflight_single_leg",
        "get_option_expirations",
        "get_option_chain",
        "get_option_greeks",
        "get_quotes",
        "get_event_summary",
        "get_event_details",
        "get_event_contract_bars",
        "get_order"
      ]
    },
    "placer": {
      "why": "trade-run place alone: the reader's endpoints, the one single-leg order, and its cancel when it is still working after the read-back",
      "endpoints": [
        "create_personal_access_token",
        "get_accounts",
        "get_instrument",
        "get_bars_v2_with_aggregation",
        "preflight_single_leg",
        "get_option_expirations",
        "get_option_chain",
        "get_option_greeks",
        "get_quotes",
        "get_event_summary",
        "get_event_details",
        "get_event_contract_bars",
        "get_order",
        "cancel_order",
        "place_order"
      ]
    }
  }
}
