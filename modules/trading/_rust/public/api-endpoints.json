      "method": "GET",
      "path": "/userapigateway/eventcontract/summary/categories",
      "command": "event-contracts categories",
      "effect": "read"
    },
    "get_event_contract_bars": {
      "group": "market_data",
      "method": "GET",
      "path": "/userapigateway/historicdata/event-contracts/{event_id}/bars/{period}",
      "command": "historicdata event-contract-bars",
      "effect": "read"
