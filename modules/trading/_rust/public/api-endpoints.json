{
  "source": "publicdotcom-cli v1.3.7, src/publicdotcom_cli/_generated/api (the pinned flake input)",
  "endpoints": {
    "cancel_order": {
      "group": "order_placement",
      "method": "DELETE",
      "path": "/userapigateway/trading/{account_id}/order/{order_id}",
      "command": "order cancel",
      "effect": "write"
    },
    "create_personal_access_token": {
      "group": "authorization",
      "method": "POST",
      "path": "/userapiauthservice/personal/access-tokens",
      "command": "auth login",
      "effect": "session"
    },
    "get_account_portfolio_v2": {
      "group": "account_details",
      "method": "GET",
      "path": "/userapigateway/trading/{account_id}/portfolio/v2",
      "command": "portfolio show",
      "effect": "read"
    },
    "get_accounts": {
      "group": "list_accounts",
      "method": "GET",
      "path": "/userapigateway/trading/account",
      "command": "accounts list",
      "effect": "read"
    },
    "get_all_instruments": {
      "group": "instrument_details",
      "method": "GET",
      "path": "/userapigateway/trading/instruments",
      "command": "instruments list",
      "effect": "read"
    },
    "get_bars_v2": {
      "group": "market_data",
      "method": "GET",
      "path": "/userapigateway/historicdata/{type_}/{symbol}/{period}",
      "command": "historicdata bars",
      "effect": "read"
    },
    "get_bars_v2_with_aggregation": {
      "group": "market_data",
      "method": "GET",
      "path": "/userapigateway/historicdata/{type_}/{symbol}/{period}/{aggregation}",
      "command": "historicdata bars",
      "effect": "read"
    },
    "get_bond_details": {
