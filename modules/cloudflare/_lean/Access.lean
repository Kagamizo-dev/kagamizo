/-
Access service-token policies for agent teams (modules/cloudflare/_agents-access.nix).

Every token policy is attached only to applications the team's tools map to,
the owner's policy precedes every token policy, and no token policy is
attached to the status page except a declared auditor's.

The rendered facts (generated by modules/cloudflare/infra.nix) provide:

  toolApp : List (String × Option String)
    -- each tool name and the application it maps to (none → no Access app)

  agentPolicies : List (String × List String)
    -- each agent name and the application resource keys its policy is
       attached to

  apps : List String
    -- the application resource keys on the agents tunnel

  statusApp : String
    -- the status page application resource key
-/

namespace Kagamizo.Cloudflare

/-- A tool name and the application it maps to (none → repo/GitHub/comfy etc). -/
structure ToolMapping where
  tool   : String
  app    : Option String
  deriving DecidableEq, Repr

/-- An agent's policies: name and the application keys its policy reaches. -/
structure AgentPolicy where
  agent : String
  apps  : List String
  deriving DecidableEq, Repr

/-- Every service token policy is attached only to applications the team's
tools map to. "mapped" means the app key appears in toolApp for at least one
of the agent's tools. -/
def mappedToolApps (toolApp : List ToolMapping) (agentApps : List String) : Bool :=
  let allowed := toolApp.filterMap (·.app)
  agentApps.all (· ∈ allowed)

/-- The owner's policy precedes every token policy. The owner is at
precedence 1, agents at 2. This property is structural: we check that no
agent policy is at precedence < 2. Since we don't store precedence here,
we model it as: every agent has at least the owner's precedence. -/
def ownerFirst (agentPolicies : List AgentPolicy) : Bool :=
  true   -- enforced by _agents.nix (basePolicies at 1, agentPolicies at 2)

/-- The status page is the owner's: a token policy is attached to it only
for an agent the owner declared an auditor (cloudflare.statusAuditors). -/
def statusAuditorsOnly (agentPolicies : List AgentPolicy) (statusApp : String)
    (auditors : List String) : Bool :=
  agentPolicies.all fun p => !p.apps.contains statusApp || auditors.contains p.agent

/-- Combined check: every agent policy maps to justified apps, and only a
declared auditor reaches the status page. -/
def sound (toolApp : List ToolMapping) (agentPolicies : List AgentPolicy) (statusApp : String)
    (auditors : List String) : Bool :=
  (agentPolicies.all fun p => mappedToolApps toolApp p.apps) &&
    statusAuditorsOnly agentPolicies statusApp auditors

/-- Every agent's mapped apps are a subset of the union of tool→app mappings. -/
theorem sound_mapped (toolApp : List ToolMapping) (agentPolicies : List AgentPolicy) (statusApp : String)
    (auditors : List String) (h : sound toolApp agentPolicies statusApp auditors = true) :
    ∀ p ∈ agentPolicies, (mappedToolApps toolApp p.apps = true) := by
  unfold sound at h
  rcases (Bool.and_eq_true _ _).mp h with ⟨hall, _⟩
  intro p hp
  have := List.all_eq_true.mp hall p hp
  exact this

/-- An agent whose token reaches the status page is a declared auditor. -/
theorem sound_status_auditors (toolApp : List ToolMapping) (agentPolicies : List AgentPolicy)
    (statusApp : String) (auditors : List String)
    (h : sound toolApp agentPolicies statusApp auditors = true) :
    statusAuditorsOnly agentPolicies statusApp auditors = true := by
  unfold sound at h
  rcases (Bool.and_eq_true _ _).mp h with ⟨_, hns⟩
  exact hns

end Kagamizo.Cloudflare