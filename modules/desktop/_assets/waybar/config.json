{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 6,
  "modules-left": ["custom/apps", "custom/terminal", "custom/browser", "custom/help"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "battery", "custom/quit"],

  "custom/apps": {
    "format": "  Apps",
    "tooltip-format": "Open the app launcher (Mod+D)",
    "on-click": "fuzzel"
  },
  "custom/terminal": {
    "format": "  Terminal",
    "tooltip-format": "Open a terminal (Mod+Return)",
    "on-click": "foot -e tmux new-session -A -s main \"welcome; exec bash\""
  },
  "custom/browser": {
    "format": "  Firefox",
    "tooltip-format": "Open Firefox (Mod+B)",
    "on-click": "firefox"
  },
  "custom/help": {
    "format": "  Help",
    "tooltip-format": "Show the keys and the system check",
    "on-click": "foot -e bash -c \"welcome; exec bash\""
  },
  "custom/quit": {
    "format": "",
    "tooltip-format": "Quit the session (Mod+Shift+E)",
    "on-click": "niri msg action quit"
  },

  "clock": {
    "format": "  {:%a %d %b   %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  muted",
    "format-icons": { "default": ["", ""] },
    "tooltip-format": "Click to mute, scroll to change the volume",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "network": {
    "format-wifi": "  {essid} {signalStrength}%",
    "format-ethernet": "  {ifname}",
    "format-disconnected": "  Offline: click to connect",
    "tooltip-format": "Click to open the Wi-Fi menu",
    "on-click": "foot -e nmtui"
  },
  "battery": {
    "states": { "warning": 25, "critical": 12 },
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}"
  }
}
