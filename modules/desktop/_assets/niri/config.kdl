// niri config for the live image. Docs: https://yalter.github.io/niri/
// Mod = the Super (Windows) key.

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
        dwt
    }
}

layout {
    gaps 12
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 3
        active-color "#7aa2f7"
        inactive-color "#414868"
    }
    border { off; }
    // Shown for a moment before the wallpaper loads; matches the wallpaper's night sky.
    background-color "#14162b"
}

prefer-no-csd

// Wallpaper (niri does not draw one itself); /etc/wallpaper.png comes from the desktop profile.
spawn-at-startup "swaybg" "-i" "/etc/wallpaper.png" "-m" "fill"
spawn-at-startup "waybar" "-c" "/etc/waybar/config.json" "-s" "/etc/waybar/style.css"
spawn-at-startup "foot" "-e" "tmux" "new-session" "-A" "-s" "main" "welcome; setup; exec bash"

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Launch
    Mod+Return hotkey-overlay-title="Open a terminal" { spawn "foot" "-e" "tmux" "new-session" "-A" "-s" "main" "welcome; exec bash"; }
    Mod+T { spawn "foot"; }
    Mod+D hotkey-overlay-title="Open the app launcher" { spawn "fuzzel"; }
    Mod+B hotkey-overlay-title="Open Firefox" { spawn "firefox"; }
    Mod+Q hotkey-overlay-title="Close the window" { close-window; }

    // Move around: columns left/right, windows up/down inside a column
    Mod+H hotkey-overlay-title="Move left (Mod+L: right)" { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J hotkey-overlay-title="Move down in a column (Mod+K: up)" { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }

    // Rearrange
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Workspaces stack vertically
    Mod+U hotkey-overlay-title="Next workspace (Mod+I: previous)" { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Shift+U { move-column-to-workspace-down; }
    Mod+Shift+I { move-column-to-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    // Sizes
    Mod+R hotkey-overlay-title="Cycle the window width" { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Media and brightness keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    Print { screenshot; }
    Mod+Shift+E hotkey-overlay-title="Quit the session" { quit; }
}
