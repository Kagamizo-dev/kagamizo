#!/bin/sh
# A stand-in for secretspec in the check: PASSKEY lives in a file.
set -eu
cmd=$1; shift
from=
while [ $# -gt 0 ]; do case $1 in --from-file) from=$2; shift 2 ;; --*) shift 2 ;; *) shift ;; esac; done
case $cmd in
  get) cat "$SECRETSPEC_STUB_DIR/PASSKEY" ;;
  set) cp "$from" "$SECRETSPEC_STUB_DIR/PASSKEY" ;;
esac
