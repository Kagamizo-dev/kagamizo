// The Kagamizo shell's session (modules/shell): the shell on the top
// workspace, and every app full screen on a workspace of its own below it.
// niri stacks workspaces vertically, so switching apps is moving up and down.
input {
    keyboard { xkb { layout "us"; } }
    touchpad { tap; natural-scroll; dwt; }
}

layout {
    gaps 0
    center-focused-column "always"
    default-column-width { proportion 1.0; }
    focus-ring { off; }
    border { off; }
    background-color "#121418"
}

prefer-no-csd
hotkey-overlay { skip-at-startup; }

workspace "home"

window-rule {
    open-maximized true
}

window-rule {
    match app-id="^kagamizo-shell$"
    open-on-workspace "home"
    open-fullscreen true
}

spawn-at-startup "kagamizo-shell"

binds {
    // Home: back to the shell, from anywhere.
    Mod+Escape hotkey-overlay-title="Home" { focus-workspace "home"; }
    Mod+H { focus-workspace "home"; }
    // The app above and the app below.
    Mod+Up hotkey-overlay-title="The app above (Mod+Down: below)" { focus-workspace-up; }
    Mod+Down { focus-workspace-down; }
    Mod+K { focus-workspace-up; }
    Mod+J { focus-workspace-down; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    // Reorder: carry the app up or down the stack.
    Mod+Shift+Up { move-column-to-workspace-up; }
    Mod+Shift+Down { move-column-to-workspace-down; }
    Mod+Q hotkey-overlay-title="Close the app" { close-window; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    Print { screenshot; }
    Mod+Shift+E hotkey-overlay-title="Quit the session" { quit; }
}
