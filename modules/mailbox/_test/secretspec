#!/bin/sh
# A stand-in for secretspec in the check: each secret is a file named after it.
set -eu
# It runs as the caller: pass-cli's session is under the caller's XDG data
# folder, never Bridge's private one.
[ "${XDG_DATA_HOME:-}" = "$EXPECT_XDG_DATA_HOME" ] || { echo "secretspec run with Bridge's XDG_DATA_HOME" >&2; exit 1; }
cmd=$1 name=$2; shift 2
from=
while [ $# -gt 0 ]; do case $1 in --from-file) from=$2; shift 2 ;; --*) shift 2 ;; *) shift ;; esac; done
case $cmd in
  get) cat "$SECRETSPEC_STUB_DIR/$name" ;;
  set) cp "$from" "$SECRETSPEC_STUB_DIR/$name" ;;
esac
