{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "NixOS",
    "color": { "1": "magenta", "2": "blue" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta", "title": "blue" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": " OS      " },
    { "type": "host", "key": "󰌢 Laptop  " },
    { "type": "kernel", "key": " Kernel  " },
    { "type": "uptime", "key": "󰅐 Up      " },
    { "type": "cpu", "key": " CPU     " },
    { "type": "gpu", "key": "󰢮 GPU     " },
    { "type": "memory", "key": "󰍛 RAM     " },
    { "type": "battery", "key": "󰁹 Battery " },
    { "type": "localip", "key": "󰩟 IP      " },
    { "type": "wm", "key": " Desktop " },
    { "type": "terminal", "key": " Terminal" },
    "break",
    "colors"
  ]
}
